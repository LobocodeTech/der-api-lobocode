@baseUrl = http://localhost:30100
@companyId = cmeugkss50000ltt6ewnxidgy

@token = {{ systemAdminLogin.response.body.access_token }}

### Login SYSTEM_ADMIN
# @name systemAdminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "login": "systemadmin@user.com",
    "password": "SystemAdmin123@Senha"
}

### ========================================
### USERS - SYSTEM_ADMIN (Tenant Global)
### ========================================

### Listar TODOS os usuários
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Buscar usuário específico (qualquer empresa)
GET {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{token}}

### Atualizar usuário (qualquer empresa)
PATCH {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Usuário Atualizado pelo System Admin",
    "status": "ACTIVE"
}

### Deletar usuário (qualquer empresa)
DELETE {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{token}}

### ========================================
### USERS - SYSTEM_ADMIN (Tenant Específico)
### ========================================

### Listar usuários de empresa específica
GET {{baseUrl}}/users?companyId={{companyId}}
Authorization: Bearer {{token}}

### Buscar usuário de empresa específica
GET {{baseUrl}}/users/USER_ID_AQUI?companyId={{companyId}}
Authorization: Bearer {{token}}

### ========================================
### CREATE USERS - SYSTEM_ADMIN
### ========================================

### Criar novo SYSTEM_ADMIN
POST {{baseUrl}}/users/system-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Novo System Admin",
    "login": "novo.systemadmin",
    "email": "novo.systemadmin@user.com",
    "password": "SystemAdmin123@Senha"
}

### Criar ADMIN em empresa específica
POST {{baseUrl}}/users/admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Admin Empresa A",
    "login": "admin.empresaA",
    "email": "admin.empresaA@user.com",
    "password": "SystemAdmin123@Senha",
    "companyId": "{{companyId}}"
}

### Criar FIELD_TEAM em empresa específica
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Equipe de Campo Empresa A",
    "login": "field.empresaA",
    "email": "field.empresaA@user.com",
    "password": "SystemAdmin123@Senha",
    "role": "FIELD_TEAM",
    "companyId": "{{companyId}}"
}

### Criar C2C em empresa específica
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Operador C2C Empresa A",
    "login": "c2c.empresaA",
    "email": "c2c.empresaA@user.com",
    "password": "SystemAdmin123@Senha",
    "role": "C2C",
    "companyId": "{{companyId}}"
}

### ========================================
### RECURSOS DER - SYSTEM_ADMIN
### ========================================

### Listar empresas
GET {{baseUrl}}/companies
Authorization: Bearer {{token}}

### Listar regionais
GET {{baseUrl}}/regionals
Authorization: Bearer {{token}}

### Listar localizações
GET {{baseUrl}}/locations
Authorization: Bearer {{token}}

### Listar ativos
GET {{baseUrl}}/assets
Authorization: Bearer {{token}}

### Listar ordens de serviço
GET {{baseUrl}}/work-orders
Authorization: Bearer {{token}}

### Listar planejamentos
GET {{baseUrl}}/planning
Authorization: Bearer {{token}}
