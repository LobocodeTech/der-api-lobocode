@baseUrl = http://localhost:30100
@companyId = cmcy2a0bg0000ltjnu6o728nr

@token = {{ systemAdminLogin.response.body.access_token }}

### Login SYSTEM_ADMIN
# @name systemAdminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
    "login": "systemadmin@user.com",
    "password": "SystemAdmin123@Senha"
}

### ========================================
### CREATE ALL USER TYPES - DER
### Roles: SYSTEM_ADMIN, ADMIN, FIELD_TEAM, C2C
### ========================================

### 1. Criar SYSTEM_ADMIN
POST {{baseUrl}}/users/system-admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Novo System Admin",
    "login": "novo.systemadmin",
    "email": "novo.systemadmin@user.com",
    "password": "SystemAdmin123@Senha"
}

### 2. Criar ADMIN
POST {{baseUrl}}/users/admin
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Admin da Empresa",
    "login": "admin.empresa",
    "email": "admin.empresa@user.com",
    "password": "SystemAdmin123@Senha",
    "companyId": "{{companyId}}"
}

### 3. Criar FIELD_TEAM
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Equipe de Campo",
    "login": "field.empresa",
    "email": "field.empresa@user.com",
    "password": "SystemAdmin123@Senha",
    "role": "FIELD_TEAM",
    "companyId": "{{companyId}}"
}

### 4. Criar C2C
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{token}}

{
    "name": "Operador C2C",
    "login": "c2c.empresa",
    "email": "c2c.empresa@user.com",
    "password": "SystemAdmin123@Senha",
    "role": "C2C",
    "companyId": "{{companyId}}"
}

### ========================================
### LIST ALL CREATED USERS
### ========================================

### Listar todos os usuários
GET {{baseUrl}}/users
Authorization: Bearer {{token}}

### Listar usuários por empresa
GET {{baseUrl}}/users?companyId={{companyId}}
Authorization: Bearer {{token}}

### Listar por role FIELD_TEAM
GET {{baseUrl}}/users?role=FIELD_TEAM
Authorization: Bearer {{token}}

### ========================================
### UPDATE TESTS
### ========================================

### Atualizar usuário
PATCH {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{token}}
Content-Type: application/json

{
    "name": "Usuário Atualizado",
    "status": "ACTIVE"
}

### ========================================
### SOFT DELETE TESTS
### ========================================

### Deletar um usuário (soft delete)
DELETE {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{token}}

### Restaurar usuário deletado
POST {{baseUrl}}/users/USER_ID_AQUI/restore
Authorization: Bearer {{token}}

### Listar usuários deletados
GET {{baseUrl}}/users?deletedOnly=true
Authorization: Bearer {{token}}
