@baseUrl = http://localhost:30100

### ========================
### LOGIN E TOKENS - ROLES DER
### ========================

###
# @name systemAdminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "systemadmin@user.com",
  "password": "SystemAdmin123@Senha"
}

###
# @name adminLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "admin@user.com",
  "password": "SystemAdmin123@Senha"
}

###
# @name fieldTeamLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "field.empresa@user.com",
  "password": "SystemAdmin123@Senha"
}

###
# @name c2cLogin
POST {{baseUrl}}/auth/login
Content-Type: application/json

{
  "login": "c2c.empresa@user.com",
  "password": "SystemAdmin123@Senha"
}

@tokenSystemAdmin = {{systemAdminLogin.response.body.access_token}}
@tokenAdmin = {{adminLogin.response.body.access_token}}
@tokenFieldTeam = {{fieldTeamLogin.response.body.access_token}}
@tokenC2c = {{c2cLogin.response.body.access_token}}

### ========================
### CRIAÇÃO DE USUÁRIOS
### ========================

### Criar ADMIN (SYSTEM_ADMIN)
POST {{baseUrl}}/users/admin
Content-Type: application/json
Authorization: Bearer {{tokenSystemAdmin}}

{
  "name": "Admin",
  "login": "admin@user.com",
  "email": "admin@user.com",
  "password": "SystemAdmin123@Senha",
  "companyId": "COMPANY_ID_AQUI"
}

### Criar FIELD_TEAM
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Equipe de Campo",
  "login": "field.empresa@user.com",
  "email": "field.empresa@user.com",
  "password": "SystemAdmin123@Senha",
  "role": "FIELD_TEAM"
}

### Criar C2C com permissões CASL (WorkOrder / User)
POST {{baseUrl}}/users
Content-Type: application/json
Authorization: Bearer {{tokenAdmin}}

{
  "name": "Operador C2C",
  "login": "c2c.empresa@user.com",
  "email": "c2c.empresa@user.com",
  "password": "SystemAdmin123@Senha",
  "role": "C2C",
  "permissions": [
    {
      "action": "read",
      "resource": "User"
    },
    {
      "action": "update",
      "resource": "WorkOrder",
      "condition": {
        "id": "1"
      }
    }
  ]
}

### ========================
### USERS
### ========================

### Listar todos os usuários (Admin)
GET {{baseUrl}}/users
Authorization: Bearer {{tokenAdmin}}

### Obter usuário específico
GET {{baseUrl}}/users/USER_ID_AQUI
Authorization: Bearer {{tokenAdmin}}

### Listar ordens de serviço (FIELD_TEAM)
GET {{baseUrl}}/work-orders
Authorization: Bearer {{tokenFieldTeam}}

### ========================
### ROOT (TESTE DE AUTENTICAÇÃO)
### ========================

### Testar acesso à rota raiz
GET {{baseUrl}}/
Authorization: Bearer {{tokenC2c}}
